# Roundtable worker EnvironmentFile (M8) — template only, no secrets in here.
#
# Install with:
#   sudo cp deploy/roundtable-worker.env.example /srv/roundtable/worker.env
#   sudo chown roundtable:roundtable /srv/roundtable/worker.env
#   sudo chmod 600 /srv/roundtable/worker.env
# Then edit /srv/roundtable/worker.env and fill in the three secrets
# below. Never commit the installed file anywhere. systemd reads this
# file when the service starts; the worker itself never reads it.
# No spaces are allowed in values.

# The board. On the VM itself, use the loopback URL (the worker
# allows http only for loopback hosts); anywhere else, use the
# public https URL.
ROUNDTABLE_URL=http://127.0.0.1:8000/mcp
# The worker token from docs/ADD-AGENT.md Step 4. Never paste a
# real token into this template — fill it in only in the installed
# file on the VM.
ROUNDTABLE_TOKEN=<paste-the-worker-token-here>
# The model's OpenAI-compatible endpoint and model name.
WORKER_MODEL_BASE_URL=https://api.deepseek.com/v1
WORKER_MODEL_NAME=deepseek-chat
# The model's API key. Same rule as the token: only in the
# installed file, never in the repo, never in chat.
WORKER_API_KEY=<paste-the-model-api-key-here>
# The rest keep their defaults unless you need them.
# WORKER_POLL_INTERVAL=10
# WORKER_MAX_TASKS_PER_HOUR=10
# WORKER_MODEL_TIMEOUT=120
# WORKER_COOLDOWN_SECONDS=900
# WORKER_MAX_FAILURES=3
