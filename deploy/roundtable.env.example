# Roundtable EnvironmentFile (M3) — template only, no secrets in here.
#
# Install with:
#   sudo cp deploy/roundtable.env.example /srv/roundtable/roundtable.env
#   sudo chown roundtable:roundtable /srv/roundtable/roundtable.env
#   sudo chmod 600 /srv/roundtable/roundtable.env
# Then edit /srv/roundtable/roundtable.env and set ROUNDTABLE_ALLOWED_HOSTS
# to your real public DNS name. Never commit the installed file anywhere.
# systemd reads this file when the service starts; the app itself never
# reads it. No spaces are allowed in values.

# The app binds to loopback only. Never change this to 0.0.0.0.
ROUNDTABLE_HOST=127.0.0.1
ROUNDTABLE_PORT=8000
ROUNDTABLE_DB_PATH=/srv/roundtable/data/roundtable.db
ROUNDTABLE_AGENTS_CONFIG=/srv/roundtable/agents.json
ROUNDTABLE_RATE_LIMIT_PER_MINUTE=60
# Public DNS name(s) the app accepts behind nginx (comma-separated).
# Replace roundtable.example.com with your real name, e.g.
# mylabel.westeurope.cloudapp.azure.com. Leave the line unset (delete it)
# for loopback-only. Never put '*' here.
ROUNDTABLE_ALLOWED_HOSTS=roundtable.example.com
