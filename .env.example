# Copy to .env for local runs. Never commit .env or agents.json.
# Server binds to 127.0.0.1 by default (SPEC section 7.5).
ROUNDTABLE_HOST=127.0.0.1
ROUNDTABLE_PORT=8000
ROUNDTABLE_DB_PATH=roundtable.db
ROUNDTABLE_AGENTS_CONFIG=agents.json
# Tool calls allowed per token per minute (SPEC section 7.3, default 60).
ROUNDTABLE_RATE_LIMIT_PER_MINUTE=60
# Extra Host values the server accepts behind a reverse proxy
# (comma-separated). Fake value only; replace with your public DNS name
# when deploying (see docs/DEPLOY.md). Leave unset for loopback-only.
# Never put '*' here.
ROUNDTABLE_ALLOWED_HOSTS=roundtable.example.com

# --- Worker (worker.py, SPEC section 8) ---------------------------------
# Fake values only. The worker reads these from the environment; it never
# reads .env itself, so export them or run it with `env VAR=...`.
# ROUNDTABLE_URL is the MCP server URL; ROUNDTABLE_TOKEN is this worker's
# own bearer token from agents.json (a worker entry, not the leader's).
ROUNDTABLE_URL=http://127.0.0.1:8000/mcp
ROUNDTABLE_TOKEN=REPLACE-ME-worker-token-0000000000000000000
# OpenAI-compatible model endpoint (base URL without /chat/completions),
# e.g. https://api.deepseek.com/v1 and model deepseek-chat.
WORKER_MODEL_BASE_URL=https://api.example.invalid/v1
WORKER_MODEL_NAME=example-model
WORKER_API_KEY=REPLACE-ME-model-api-key-0000000000000000000
# Seconds between polls (default 10) and max model calls per rolling
# hour (default 10, a hard cap to protect quota — every model call
# counts, not only submitted results).
WORKER_POLL_INTERVAL=10
WORKER_MAX_TASKS_PER_HOUR=10
# Seconds before a single model call times out (default 120).
WORKER_MODEL_TIMEOUT=120
# Cool-down after a task fails before it is retried (default 900 = 15 min),
# and failures after which the worker gives up on a task and posts a
# help_request message instead (default 3).
WORKER_COOLDOWN_SECONDS=900
WORKER_MAX_FAILURES=3
